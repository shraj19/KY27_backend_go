# KY27 Payment Backend — env template. Copy to `.env` and fill in. NEVER commit `.env`.
# Convention: SCREAMING_SNAKE_CASE, provider-prefixed.

# ---- HTTP server ----
PORT=8081
CORS_ORIGINS=http://localhost:5173

# ---- Payment gateway selection: cashfree | konfhub ----
PAYMENT_PROVIDER=cashfree

# ---- Cashfree (Dashboard -> Developers -> API Keys). ENV: SANDBOX | PRODUCTION ----
CASHFREE_ENV=SANDBOX
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_RETURN_URL=https://your-frontend/payment/return?order_id={order_id}
CASHFREE_NOTIFY_URL=https://your-backend/webhooks/cashfree

# ---- Konfhub (future) ----
KONFHUB_CLIENT_ID=
KONFHUB_CLIENT_SECRET=
