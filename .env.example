# KY27 Payment Backend — env template. Copy to `.env` and fill in. NEVER commit `.env`.

# ---- Environment ----
# development/test: loads from .env file
# production: loads from AWS SSM Parameter Store
APP_ENV=development

# ---- SSM Config (production only) ----
# Parameters are fetched from SSM_PREFIX/parameter_name
# e.g., /ky27/prod/database_url → DATABASE_URL
SSM_PREFIX=/ky27/prod
AWS_REGION=ap-south-1

# ---- Server ----
PORT=8081
GRPC_PORT=50051
CORS_ORIGINS=http://localhost:5173

# ---- Database (Neon Postgres) ----
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Service-to-service auth (shared between Node and Go) ----
SERVICE_TOKEN=your-secure-random-token

# ---- Node backend webhook URL (Go notifies Node when payment completes) ----
NODE_WEBHOOK_URL=http://localhost:3000/internal/webhooks/payment-completed

# ---- Payment gateway ----
PAYMENT_PROVIDER=cashfree  # cashfree | razorpay

# ---- Cashfree (Dashboard -> Developers -> API Keys) ----
CASHFREE_ENV=SANDBOX  # SANDBOX | PRODUCTION
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_RETURN_URL=https://your-frontend/payment/return?order_id={order_id}
CASHFREE_NOTIFY_URL=https://your-backend/webhooks/cashfree

# ---- Razorpay (future) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Grafana Cloud (traces, metrics, logs via OTLP) ----
TEMPO_ENDPOINT=otlp-gateway-prod-xxx.grafana.net:443
TEMPO_USER=your-instance-id
TEMPO_API_KEY=your-api-key
